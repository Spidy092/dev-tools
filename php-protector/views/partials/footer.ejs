<div class="toast-container" id="toast-container"></div>

<script src="/js/toast.js"></script>
<script src="/js/theme.js"></script>
<script src="/js/shortcuts.js"></script>
<script src="/js/cmd-palette.js"></script>
<script nonce="<%= locals.nonce || '' %>">
(function() {
  var nonce = '<%= locals.nonce || "" %>';
  var scripts = ['/js/utils.js', '/js/settings.js', '/js/virtual-tree.js', '/js/tool-runner-v2.js'];
  function load(i) {
    if (i >= scripts.length) return;
    var script = document.createElement('script');
    script.src = scripts[i];
    if (nonce) script.setAttribute('nonce', nonce);
    script.onload = function() { load(i + 1); };
    document.body.appendChild(script);
  }
  if (window.requestIdleCallback) requestIdleCallback(function() { load(0); });
  else setTimeout(function() { load(0); }, 0);
})();
</script>
