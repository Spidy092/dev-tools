<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="DevToolkit — fast developer utilities for image processing, PDF compression, file operations, code minification, and PHP obfuscation.">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'DevToolkit' %>">
<meta property="og:description" content="Developer utilities for single files, multiple files, and bulk folders.">
<meta property="og:type" content="website">
<title><%= typeof title !== 'undefined' ? title : 'DevToolkit' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/enterprise.css">
<link rel="stylesheet" href="/css/queue.css">
<script nonce="<%= locals.nonce || '' %>">
// Apply saved theme before paint to prevent flash
(function(){var t=localStorage.getItem('devtoolkit_theme');if(t)document.documentElement.setAttribute('data-theme',t)})();
if('serviceWorker' in navigator)navigator.serviceWorker.register('/sw.js').catch(function(){});
</script>
