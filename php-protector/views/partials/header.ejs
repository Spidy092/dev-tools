<nav class="topnav" aria-label="Primary navigation">
  <a href="/" class="topnav-brand"><span class="brand-mark">D</span><span class="brand-name">Dev<span>Toolkit</span></span></a>

  <div class="topnav-section-label">Tools</div>
  <div class="topnav-links">
    <% (locals.tools || []).forEach(function(navTool) { %>
      <a href="<%= navTool.route %>" class="topnav-link" title="<%= navTool.name %>" aria-label="<%= navTool.name %>">
        <span class="nav-icon" aria-hidden="true"><%= navTool.icon %></span>
        <span class="nav-label"><%= navTool.name %></span>
      </a>
    <% }) %>
  </div>

  <div class="topnav-actions">
    <button class="topnav-cmd" id="open-command-palette" type="button" title="Search tools (Ctrl/Cmd+K)">
      <span class="nav-icon" aria-hidden="true">⌕</span><span class="nav-label">Search</span><kbd>⌘K</kbd>
    </button>
    <a href="/settings" class="topnav-link" title="Settings" aria-label="Settings">
      <span class="nav-icon" aria-hidden="true">⚙️</span><span class="nav-label">Settings</span>
    </a>
  </div>
</nav>

<div class="page-header">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="sep" aria-hidden="true">›</span>
    <span class="current"><%= typeof h1Left !== 'undefined' ? h1Left + ' ' + (typeof h1Right !== 'undefined' ? h1Right : '') : 'Tool' %></span>
  </nav>
  <div class="logo-pill"><%= typeof pill !== 'undefined' ? pill : 'ENGINE' %></div>
  <h1><%= typeof h1Left !== 'undefined' ? h1Left : '' %> <span><%= typeof h1Right !== 'undefined' ? h1Right : '' %></span></h1>
  <p class="subtitle"><%= typeof subtitle !== 'undefined' ? subtitle : '' %></p>
</div>
