NODE_ENV=development
PORT=3000

# Reverse proxy / network
# Keep TRUST_PROXY=1 when exactly one trusted proxy (for example Nginx/ALB) sits in front.
# Set false when exposing Node directly.
TRUST_PROXY=1
RATE_LIMIT_PER_MINUTE=180
MAX_REQUEST_SIZE_MB=505
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=70000
REQUEST_TIMEOUT_MS=360000
SHUTDOWN_GRACE_MS=15000

# Upload limits
MAX_FILE_SIZE_MB=100
MAX_TOTAL_SIZE_MB=500
MAX_FILES=5000

# Temporary file lifecycle
CLEANUP_INTERVAL_MIN=15
STALE_AGE_MIN=30

# Unified job lifecycle
JOB_TIMEOUT_MS=300000
JOB_TTL_MS=600000
MAX_PENDING_JOB_EVENTS=250

# Processor resource limits
PDF_PROCESS_TIMEOUT_MS=120000
MAX_IMAGE_PIXELS=100000000
MAX_IMAGE_OUTPUT_WIDTH=16384
SHARP_CONCURRENCY=2
SHARP_CACHE_MEMORY_MB=64
SHARP_CACHE_FILES=20
SHARP_CACHE_ITEMS=100

# Readiness protection. Keep below the Node --max-old-space-size value.
READINESS_MAX_HEAP_MB=1800
